datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  organizations     Organization[]
  departments       Department[]
  designations      Designation[]
  locations         Location[]
  shifts            Shift[]
  employees         Employee[]
  attendancePunches AttendancePunch[]
  dailyAttendance   DailyAttendance[]
  leaveRequests     LeaveRequest[]
  tickets           Ticket[]
  assets            Asset[]
  assetCategories   AssetCategoryMaster[]
  custodyReceipts   CustodyReceipt[]
  exitClearances    ExitClearance[]
  auditLogs         AuditLog[]
  notifications     SystemNotification[]
}

model Organization {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  legalEntity String
  cinOrGstin  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  locations   Location[]
}

model Location {
  id                   String   @id @default(uuid())
  tenantId             String
  organizationId       String?
  name                 String
  code                 String
  address              String
  city                 String
  country              String   @default("India")
  latitude             Float
  longitude            Float
  geofenceRadiusMeters Float    @default(200.0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization         Organization? @relation(fields: [organizationId], references: [id])
  employees            Employee[]
  assets               Asset[]
}

model Department {
  id             String   @id @default(uuid())
  tenantId       String
  organizationId String?
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  employees      Employee[]
}

model Designation {
  id        String   @id @default(uuid())
  tenantId  String
  title     String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         String   @default("EMPLOYEE") // RoleEnum
  isActive     Boolean  @default(true)
  employeeId   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     Employee? @relation(fields: [employeeId], references: [id])

  assignedTickets Ticket[] @relation("TicketAssignee")
  createdTickets  Ticket[] @relation("TicketRequester")
  auditLogs       AuditLog[]
  notifications   SystemNotification[]

  @@unique([tenantId, email])
}

model Employee {
  id               String    @id @default(uuid())
  tenantId         String
  employeeCode     String
  firstName        String
  lastName         String
  email            String
  phone            String?
  departmentId     String
  designationId    String
  locationId       String
  managerId        String?
  joiningDate      DateTime
  confirmationDate DateTime?
  status           String    @default("PROBATION") // EmployeeStatus
  employmentType   String    @default("FULL_TIME") // EmploymentType
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department        Department        @relation(fields: [departmentId], references: [id])
  designation       Designation       @relation(fields: [designationId], references: [id])
  location          Location          @relation(fields: [locationId], references: [id])
  manager           Employee?         @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates      Employee[]        @relation("ManagerSubordinates")
  user              User?
  attendancePunches AttendancePunch[]
  dailyAttendance   DailyAttendance[]
  leaveRequests     LeaveRequest[]
  assignedAssets    Asset[]           @relation("EmployeeAssignedAssets")
  custodyReceipts   CustodyReceipt[]
  exitClearances    ExitClearance[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, email])
}

model Shift {
  id                      String   @id @default(uuid())
  tenantId                String
  name                    String
  code                    String
  startTime               String   // "09:00"
  endTime                 String   // "18:00"
  gracePeriodMinutes      Int      @default(15)
  halfDayThresholdMinutes Int      @default(240) // 4 hours
  fullDayThresholdMinutes Int      @default(480) // 8 hours
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dailyAttendance         DailyAttendance[]
}

model AttendancePunch {
  id               String   @id @default(uuid())
  tenantId         String
  employeeId       String
  timestamp        DateTime @default(now())
  punchType        String   // CHECK_IN, CHECK_OUT
  mode             String   // MOBILE_GPS, WEB_PORTAL, BIOMETRIC_DEVICE
  latitude         Float?
  longitude        Float?
  isWithinGeofence Boolean  @default(true)
  deviceId         String?
  createdAt        DateTime @default(now())

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model DailyAttendance {
  id                      String   @id @default(uuid())
  tenantId                String
  employeeId              String
  date                    String   // "YYYY-MM-DD"
  shiftId                 String?
  firstCheckIn            DateTime?
  lastCheckOut            DateTime?
  totalWorkMinutes        Int      @default(0)
  status                  String   @default("ABSENT") // PRESENT, ABSENT, HALF_DAY, ON_LEAVE
  isLate                  Boolean  @default(false)
  isEarlyDeparture        Boolean  @default(false)
  regularizationRequested Boolean  @default(false)
  regularizationApproved  Boolean?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee                Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift                   Shift?    @relation(fields: [shiftId], references: [id])

  @@unique([tenantId, employeeId, date])
}

model LeaveRequest {
  id               String   @id @default(uuid())
  tenantId         String
  employeeId       String
  leaveType        String   // EARNED_LEAVE, CASUAL_LEAVE, SICK_LEAVE
  startDate        String   // "YYYY-MM-DD"
  endDate          String   // "YYYY-MM-DD"
  totalDays        Float
  reason           String
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approverId       String?
  approverComments String?
  appliedAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Ticket {
  id              String    @id @default(uuid())
  ticketNumber    String
  tenantId        String
  requesterId     String
  assigneeId      String?
  title           String
  description     String
  category        String    @default("HARDWARE") // HARDWARE, SOFTWARE, NETWORK
  priority        String    @default("MEDIUM")   // LOW, MEDIUM, HIGH, URGENT
  status          String    @default("NEW")      // NEW, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED
  linkedAssetId   String?
  responseDueAt   DateTime?
  resolutionDueAt DateTime?
  isSlaBreached   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester       User      @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee        User?     @relation("TicketAssignee", fields: [assigneeId], references: [id])
  linkedAsset     Asset?    @relation(fields: [linkedAssetId], references: [id])
  comments        TicketComment[]

  @@unique([tenantId, ticketNumber])
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  authorId   String
  authorName String
  content    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model AssetCategoryMaster {
  id                  String   @id @default(uuid())
  tenantId            String
  code                String   // LAPTOP, MOBILE, MONITOR, DESKTOP, ACCESSORY, SERVER, OTHER, etc.
  name                String   // e.g. "Smartphones & Cellular Devices"
  tagPrefix           String   // e.g. "AST-MOB"
  minSafetyBuffer     Int      @default(3)
  usefulLifeMonths    Int      @default(36)
  salvageValuePercent Float    @default(5.0)
  requiresCustodySign Boolean  @default(true)
  isSerialized        Boolean  @default(true)
  icon                String?  @default("Laptop")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets              Asset[]

  @@unique([tenantId, code])
}

model Asset {
  id                   String    @id @default(uuid())
  assetTag             String
  tenantId             String
  name                 String
  categoryId           String?
  category             String    @default("LAPTOP") // LAPTOP, DESKTOP, MONITOR
  brand                String
  model                String
  serialNumber         String
  purchaseDate         DateTime
  purchaseCost         Float
  currentBookValue     Float
  warrantyExpiry       DateTime?
  status               String    @default("IN_STOCK") // IN_STOCK, ASSIGNED, IN_REPAIR, RETIRED
  assignedToEmployeeId String?
  locationId           String?
  lastAuditedAt        DateTime?
  lastAuditedBy        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryMaster       AssetCategoryMaster? @relation(fields: [categoryId], references: [id])
  assignedTo           Employee?            @relation("EmployeeAssignedAssets", fields: [assignedToEmployeeId], references: [id])
  location             Location?            @relation(fields: [locationId], references: [id])
  tickets              Ticket[]
  custodyReceipts      CustodyReceipt[]

  @@unique([tenantId, assetTag])
  @@unique([tenantId, serialNumber])
}

model CustodyReceipt {
  id                       String    @id @default(uuid())
  tenantId                 String
  assetId                  String
  employeeId               String
  status                   String    @default("PENDING_ACKNOWLEDGEMENT") // PENDING_ACKNOWLEDGEMENT, ACKNOWLEDGED, RETURNED
  assignedAt               DateTime  @default(now())
  acknowledgedAt           DateTime?
  signatureData            String?
  returnedAt               DateTime?
  verifiedByItTechnicianId String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset                    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee                 Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model ExitClearance {
  id                String    @id @default(uuid())
  tenantId          String
  employeeId        String
  resignationDate   DateTime
  lastWorkingDay    DateTime
  status            String    @default("IN_PROGRESS") // IN_PROGRESS, ASSETS_PENDING, CLEARED
  itNocIssued       Boolean   @default(false)
  itNocIssuedAt     DateTime?
  pendingAssetCount Int       @default(0)
  hrNocIssued       Boolean   @default(false)
  financeNocIssued  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String   // e.g., ASSET_ASSIGNED, ASSET_AUDITED, TICKET_CREATED, CUSTODY_ACKNOWLEDGED, EXIT_CLEARANCE_UPDATED
  entityType String   // e.g., Asset, Ticket, Employee, CustodyReceipt, ExitClearance
  entityId   String?
  details    String?  // JSON string or summary
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
}

model SystemNotification {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?  // null if tenant-wide or specific role
  role       String?  // e.g., IT_ADMIN, HR_ADMIN, EMPLOYEE
  title      String
  message    String
  type       String   @default("INFO") // INFO, WARNING, ALERT, SUCCESS
  link       String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])
}

